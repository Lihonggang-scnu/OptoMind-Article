{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_hash"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "object_id": {
      "minLength": 1,
      "title": "Object Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "source_run_id": {
      "minLength": 1,
      "title": "Source Run Id",
      "type": "string"
    },
    "input_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "unconsumed_metadata": {
      "additionalProperties": true,
      "title": "Unconsumed Metadata",
      "type": "object"
    },
    "schema_version": {
      "const": "selected-research-result.v1",
      "default": "selected-research-result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "inference_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "claim_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Claim Refs",
      "type": "array"
    },
    "candidate_roles": {
      "additionalProperties": true,
      "title": "Candidate Roles",
      "type": "object"
    },
    "prediction_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Prediction Refs",
      "type": "array"
    },
    "negative_result_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Negative Result Refs",
      "type": "array"
    },
    "equivalent_explanations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Equivalent Explanations",
      "type": "array"
    },
    "cost_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Cost Refs",
      "type": "array"
    },
    "asset_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Asset Refs",
      "type": "array"
    },
    "claim_strength": {
      "default": "design",
      "enum": [
        "design",
        "prediction",
        "mechanism"
      ],
      "title": "Claim Strength",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "source_run_id",
    "candidate_ref"
  ],
  "title": "SelectedResearchResult",
  "type": "object"
}
