+def _shared_whole_plan_materials(payload: Mapping[str, Any]) -> dict[str, Any]:
+    """Render repeated complete materials once, without discarding evidence.
+
+    Late material is intentionally present at chapter and whole-plan scopes.
+    Repeating its full reading history at every scope can exceed the model
+    context even for two papers. Only the coordinator prompt uses references;
+    stored packets, owner inputs and cache provenance keep the complete data.
+    """
+    catalog_key = "__shared_materials__"
+    reference_key = "$optomind_shared_material"
+    contract_key = "__shared_materials_contract__"
+    if catalog_key in payload or contract_key in payload:
+        return dict(payload)
+    counts: dict[str, int] = {}
+    encoded: dict[str, str] = {}
+
+    def collect(value: Any) -> None:
+        if isinstance(value, (Mapping, list, tuple)):
+            text = json.dumps(value, ensure_ascii=False, sort_keys=True,
+                              separators=(",", ":"), default=_json_default)
+            if len(text) >= 2048:
+                digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
+                counts[digest] = counts.get(digest, 0) + 1
+                encoded[digest] = text
+            for child in value.values() if isinstance(value, Mapping) else value:
+                collect(child)
+
+    fields = ("chapters", "late_material_changes", "tool_results_summary")
+    for key in fields:
+        if key in payload:
+            collect(payload[key])
+    catalog: dict[str, Any] = {}
+
+    def render(value: Any) -> Any:
+        if isinstance(value, (Mapping, list, tuple)):
+            text = json.dumps(value, ensure_ascii=False, sort_keys=True,
+                              separators=(",", ":"), default=_json_default)
+            digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
+            if counts.get(digest, 0) > 1 and encoded[digest] == text:
+                # Keep the complete subtree in the catalog: no truncation,
+                # historical-material filtering, or source-identity folding.
+                catalog.setdefault(digest, json.loads(text))
+                return {reference_key: digest}
+            if isinstance(value, Mapping):
+                return {key: render(child) for key, child in value.items()}
+            return [render(child) for child in value]
+        return value
+
+    result = dict(payload)
+    for key in fields:
+        if key in payload:
+            result[key] = render(payload[key])
+    if catalog:
+        result[catalog_key] = catalog
+        result[contract_key] = (
+            "含 $optomind_shared_material 的对象引用 __shared_materials__ 中同名完整材料，"
+            "请在其原章节/用途位置读取该材料。引用仅避免相同内容重复传输；"
+            "不合并章节职责，不改变来源身份、限制或历史/当前材料的区别。"
+        )
+    return result
+
+
+def _claim_scope_text_anchors(payload: Mapping[str, Any]) -> dict[str, list[dict[str, str]]]:
+    """Index existing string leaves, never author an issue or scientific answer."""
+    output: dict[str, list[dict[str, str]]] = {"claims": [], "evidence": []}
+    input_digest = hashlib.sha256(json.dumps(payload, ensure_ascii=False, sort_keys=True,
+        separators=(",", ":"), default=_json_default).encode("utf-8")).hexdigest()
+
+    def visit(value: Any, pointer: str, target: str) -> None:
+        if isinstance(value, str) and value.strip():
+            identity = json.dumps([input_digest, target, pointer, value], ensure_ascii=False, separators=(",", ":"))
+            anchor_id = ("C" if target == "claims" else "E") + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:20]
+            output[target].append({"anchor_id": anchor_id, "path": pointer, "quote": value})
+        elif isinstance(value, Mapping):
+            for key, child in value.items():
+                token = str(key).replace("~", "~0").replace("/", "~1")
+                visit(child, pointer + "/" + token, target)
+        elif isinstance(value, (list, tuple)):
+            for index, child in enumerate(value):
+                visit(child, pointer + "/" + str(index), target)
+
+    visit(payload.get("chapter_plan") or {}, "/chapter_plan", "claims")
+    for key in ("source_materials", "tool_materials"):
+        visit(payload.get(key) or [], "/" + key, "evidence")
+    return output
+
+
