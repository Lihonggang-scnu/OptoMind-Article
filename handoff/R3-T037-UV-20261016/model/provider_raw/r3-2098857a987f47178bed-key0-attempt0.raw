{"choices":[{"message":{"content":"{\n  \"schema_version\": \"focused_research.task_sheet.v2\",\n  \"task_type\": \"design/optimization\",\n  \"user_objective\": \"Design a metal-free planar multilayer dielectric filter for solar-blind UV detection, maximizing transmission in 255-280 nm while minimizing transmission in 300-700 nm and 700-1100 nm, using conventional inorganic materials on fused silica with air incidence.\",\n  \"subgoals\": [\n    {\n      \"id\": \"G1\",\n      \"objective\": \"Maximize solar-blind UV signal transmission\",\n      \"original_span\": \"尽可能透过 255–280 nm 的太阳盲紫外信号\",\n      \"operational_definition\": \"Wavelength integral of transmittance over the band, divided by band width, for equal-s/p unpolarized light at 0 degrees (execution assumption).\",\n      \"executable_metric\": {\n        \"objective_id\": \"G1\",\n        \"metric\": \"mean_transmittance\",\n        \"sense\": \"maximize\",\n        \"mean_reduction\": \"wavelength_integral_mean\",\n        \"region\": {\n          \"wavelength_nm\": [\n            255,\n            280\n          ],\n          \"angle_deg\": 0,\n          \"polarization\": \"unpolarized\"\n        }\n      }\n    },\n    {\n      \"id\": \"G2\",\n      \"objective\": \"Minimize visible background transmission\",\n      \"original_span\": \"尽可能抑制 300–700 nm 可见光背景\",\n      \"operational_definition\": \"Wavelength integral of transmittance over the band, divided by band width, for equal-s/p unpolarized light at 0 degrees (execution assumption). Suppression interpreted as transmission minimization.\",\n      \"executable_metric\": {\n        \"objective_id\": \"G2\",\n        \"metric\": \"mean_transmittance\",\n        \"sense\": \"minimize\",\n        \"mean_reduction\": \"wavelength_integral_mean\",\n        \"region\": {\n          \"wavelength_nm\": [\n            300,\n            700\n          ],\n          \"angle_deg\": 0,\n          \"polarization\": \"unpolarized\"\n        }\n      }\n    },\