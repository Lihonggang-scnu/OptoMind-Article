iginal_span\": \"700–1100 nm\"\n    },\n    {\n      \"id\": \"C4\",\n      \"constraint\": \"Incident medium: air\",\n      \"original_span\": \"空气入射\"\n    },\n    {\n      \"id\": \"C5\",\n      \"constraint\": \"Substrate: fused silica\",\n      \"original_span\": \"熔融石英基底\"\n    },\n    {\n      \"id\": \"C6\",\n      \"constraint\": \"No metal layers allowed\",\n      \"original_span\": \"不含金属层\"\n    },\n    {\n      \"id\": \"C7\",\n      \"constraint\": \"Only conventional depositable inorganic dielectric materials\",\n      \"original_span\": \"仅使用常规可沉积无机介质材料\"\n    },\n    {\n      \"id\": \"C8\",\n      \"constraint\": \"Planar multilayer film\",\n      \"original_span\": \"平面多层膜\"\n    },\n    {\n      \"id\": \"C9\",\n      \"constraint\": \"Total layer count not exceeding 30\",\n      \"original_span\": \"膜系总层数不超过 30 层\"\n    }\n  ],\n  \"known_data\": [\n    {\n      \"statement\": \"Application is for LEO space platforms detecting ozone and combustion plumes\",\n      \"original_span\": \"低轨空间平台上的太阳盲紫外臭氧与高空燃烧羽流探测器\"\n    }\n  ],\n  \"unknowns_assumptions\": [\n    {\n      \"kind\": \"assumption\",\n      \"statement\": \"Execution assumes 0 degree incidence, equal-s/p unpolarized light, and wavelength-integral mean definitions as these were not explicitly specified by the user but are required for the executable metric schema.\",\n      \"assumed_value\": \"0 deg, unpolarized, wavelength_integral_mean\",\n      \"needs_user_input\": false\n    },\n    {\n      \"kind\": \"unknown\",\n      \"statement\": \"Specific set of 'conventional depositable inorganic dielectric materials' and their UV optical constants (n, k) below 300 nm must be resolved from inventory; user did not name specific pairs like TiO2/SiO2.\",\n      \"assumed_value\": null,\n      \"needs_user_input\": false\n    },\n    {\n      \"kind\": \"unknown\",\n      \"statement\": \"Numerical thresholds for 'as high as possible' transmission or 'suppression' levels are unspecified; no 