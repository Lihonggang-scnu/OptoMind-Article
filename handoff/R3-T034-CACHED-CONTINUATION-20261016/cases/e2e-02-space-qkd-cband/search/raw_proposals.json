{
  "schema_version": "focused_research.research_routes.v2",
  "decision_clues": [
    {
      "id": "D1",
      "evidence_id": "E_7668cafefd6a2c91b5884ce0c0ddc48282d803d8db757a08ebfce2e97646fe41",
      "source_quote": "the sunlight contains a considerably large amount of 800 nm light compared to 1550 nm (in fact the intensity of 800 nm in sunlight is about 5 times that of 1550 nm). This reduces the possibility of false detection and allows us to simulate a situation where free-space quantum communication is performed in the daytime, too.",
      "structure_or_method": "Selection of 1550 nm wavelength for free-space QKD to minimize solar background noise relative to signal.",
      "physical_effect": "Reduced solar background intensity at telecom wavelengths compared to visible/NIR bands improves signal-to-noise ratio.",
      "conditions_and_unknowns": [
        "Discusses wavelength selection rationale, not coating design specifics.",
        "Does not specify layer materials or thicknesses for filtering."
      ],
      "goal_ids": [
        "G1",
        "G2"
      ],
      "inference_bridge": "Supports the requirement for high visible rejection (G2) while maintaining high transmission at 1550 nm (G1), motivating a long-pass filter topology."
    },
    {
      "id": "D2",
      "evidence_id": "E_8d1b4fcb1eea425f147f67c61c20f751ce0b32a17de40dce39ab5a19e6efb930",
      "source_quote": "Dispersion control over the ultraviolet-visible-near-infrared spectral range with HfO2/SiO2-chirped dielectric multilayers.",
      "structure_or_method": "Chirped dielectric multilayers using HfO2 and SiO2.",
      "physical_effect": "Control of dispersion and spectral response over a wide range (UV-VIS-NIR).",
      "conditions_and_unknowns": [
        "Title only; specific chirp profiles or layer counts not detailed in snippet.",
        "Exact performance metrics for visible rejection vs. C-band transmission not provided."
      ],
      "goal_ids": [
        "G1",
        "G2"
      ],
      "inference_bridge": "Suggests that varying layer thicknesses (chirping) in HfO2/SiO2 stacks can tailor the spectral edge steepness between the visible stopband and C-band passband."
    },
    {
      "id": "D3",
      "evidence_id": "E_05609165b5d2f7bc83b963192b3f9ebcf98c4fe142e032c25ea081120c7fe89a",
      "source_quote": "To achieve visible rejection, we turn to metal dielectric filters (MDFs)... the layered structure is designed to resonantly transmit light within a specific wavelength band, while out-of-band light is strongly reflected by the metal layers.",
      "structure_or_method": "Metal-dielectric filters (Fabry-Perot structures) for spectral filtering.",
      "physical_effect": "Resonant transmission in-band, strong reflection out-of-band.",
      "conditions_and_unknowns": [
        "Snippet discusses metal-dielectric filters; task constraints require all-dielectric (HfO2/SiO2).",
        "Principle of resonant cavities and DBRs is transferable to all-dielectric designs."
      ],
      "goal_ids": [
        "G1",
        "G2"
      ],
      "inference_bridge": "The concept of using a resonant cavity (spacer) between high-reflectivity mirrors (DBRs) to create a narrow or broad passband can be adapted using HfO2/SiO2 stacks instead of metal layers."
    },
    {
      "id": "D4",
      "evidence_id": "E_7dd93a4426b6f9af637686f1df221c095596ad3e8895e6e9b07fa7b77b38a7f1",
      "source_quote": "HfO2 shows 278 ppm absorption at 355 nm wavelength which is significantly higher than that of SiO2 about 4.5 ppm... The heterostructures with more incorporation of HfO2 experience high absorption and comparatively low LIDT.",
      "structure_or_method": "Heterostructure films of SiO2 and HfO2 with varying cycle ratios.",
      "physical_effect": "Absorption and laser-induced damage threshold (LIDT) depend on material composition and thickness.",
      "conditions_and_unknowns": [
        "Data provided at 355 nm (UV); task operates in Visible and C-band (NIR).",
        "Absorption in C-band is expected to be lower but not quantified here."
      ],
      "goal_ids": [
        "G1"
      ],
      "inference_bridge": "Highlights the importance of minimizing HfO2 thickness or optimizing layer ratios to reduce absorption losses, critical for maximizing single-photon transmission (G1)."
    },
    {
      "id": "D5",
      "evidence_id": "E_675773ef270e3eaa91df11cca6eba4383df369624e9ce539f86e934e8a37b0b3",
      "source_quote": "The amorphous SiO2 films show very low optical losses within a spectral range of 200 nm to 1100 nm. Laser calorimetric measurements show absorption losses of 300 nm thick SiO2 films of about 1.5 parts per million at a wavelength of 1064 nm.",
      "structure_or_method": "Atomic layer deposition (ALD) of SiO2 and HfO2 broadband antireflective multilayers.",
      "physical_effect": "Very low optical losses (absorption) in SiO2 films extending into NIR.",
      "conditions_and_unknowns": [
        "Loss data at 1064 nm; extrapolation to 1550 nm assumes similar or lower loss.",
        "Confirms suitability of SiO2 as a low-loss spacer/material for C-band."
      ],
      "goal_ids": [
        "G1"
      ],
      "inference_bridge": "Supports the use of SiO2 as the primary low-index material for thick spacers or matching layers in the C-band to minimize absorption losses."
    }
  ],
