      "id": "D1",
      "evidence_id": "E_1a57cc1a35727685e9f15f16fcce3632d8444f2ff9d9e4d7c2220202e67e8ee8",
      "source_quote": "The proposed design consists of a cascaded dielectric multilayer architecture combining SiOF, Si3N4, and BaSnO3 to achieve high visible-light transmittance together with broadband NIR rejection.",
      "structure_or_method": "Cascaded dielectric multilayer architecture for spectral separation.",
      "physical_effect": "High transmission in one band with broadband rejection in another via photonic band gap.",
      "conditions_and_unknowns": [
        "Uses different materials (SiOF, Si3N4, BaSnO3) than the task (HfO2, SiO2).",
        "Targets visible/NIR separation, not UV/SWIR.",
        "Simulated under lossless-dielectric approximation."
      ],
      "goal_ids": [
        "G1",
        "G2"
      ],
      "inference_bridge": "Hypothesize that a cascaded stack principle using HfO2/SiO2 can similarly separate the UV/Blue reflection band from the SWIR transmission band by tuning layer optical thicknesses."
    },
    {
      "id": "D4",
      "evidence_id": "E_1e40795268d4914a7f14dcf2cc3122898f0d6e6e2822cbfc83b7037f32823cee",
      "source_quote": "Our designed mirror based on TiO2/SiO2 shows an average transmission of less than 5 % in the spectrum range of 425-610 nm whereas it has an average transmission of 95 % in the spectrum range of 710-1500 nm.",
      "structure_or_method": "Cold mirror design using alternating high/low index layers (TiO2/SiO2).",
      "physical_effect": "Strong reflection in visible/near-UV and high transmission in NIR/SWIR.",
      "conditions_and_unknowns": [
        "Uses TiO2 instead of HfO2.",
        "Designed for 45 degree incidence.",
        "Transition edge is around 610-710 nm, different from the required 450-1000 nm gap."
      ],
      "goal_ids": [
        "G1",
        "G2"
      ],
      "inference_bridge": "Transfer the cold mirror topology (alternating stacks) to HfO2/SiO2, hypothesizing that shifting the quarter-wave center wavelength can move the reflection band to 300-450 nm while maintaining SWIR transmission."
    }
  ],
