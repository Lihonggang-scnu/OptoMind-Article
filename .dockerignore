.git
.git/**
.gitignore
.github

# The six formal records remain in the GitHub source tree for static replay,
# but are deliberately not copied into the default live-run image. They are
# multi-gigabyte immutable evidence assets; mount or distribute them
# separately when a deployment must expose the archive as well.
code/outputs/
code/database/s2_cache/
stage17_real_integration/

# Local credentials and runtime state
code/api_keys/*.txt
!.keep
.env
.env.*
!.env.example
**/.veritmm/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/.live_requests/
**/LIVE_RUN_CONSOLE.txt

# Development-only and user-authored local assets
code/tests/
*.docx
*.pdf
*.log
