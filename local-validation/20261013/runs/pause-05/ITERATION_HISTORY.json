    "route_snapshot": {
      "route_id": "route_01",
      "title": "Optimization of Low-High Index Two-Layer AR Coating",
      "route_kind": "optimize_existing_stack",
      "scientific_hypothesis": "A two-layer stack with the low-index material (SiO2) adjacent to air and the high-index material (TiO2) adjacent to the glass substrate will achieve a lower arithmetic mean reflectance across the 450-700 nm band than the reverse ordering, given the thickness constraints of 40-160 nm.",
      "design_principle": "Impedance matching theory suggests that stepping the refractive index from air (1.0) to substrate (1.52) via an intermediate low index (1.46) then high index (2.40) creates a smoother effective index gradient than starting with a high index jump, potentially reducing Fresnel reflections over a wider spectral range.",
      "proposed_materials": [
        "SiO2 (Gao)",
        "TiO2 (Siefke)"
      ],
      "proposed_topology": "Air / SiO2 (variable thickness) / TiO2 (variable thickness) / Glass (n=1.52)",
      "design_variables": [
        "thickness_sio2_nm",
        "thickness_tio2_nm"
      ],
      "soft_objectives": [
        "minimize arithmetic mean power reflectance (450-700 nm)",
        "achieve mean reflectance < 0.03"
      ],
      "manufacturing_considerations": [
        "Layer thicknesses must remain within 40 nm to 160 nm",
        "Exactly one layer of each material"
      ],
      "evidence_ids": [],
      "theory_basis": [
        "Fresnel equations for normal incidence",
        "Transfer Matrix Method for multilayer interference",
        "Quarter-wave and non-quarter-wave optimization principles for broadband AR"
      ],
      "expected_advantages": [
        "The Low-High ordering provides a better match to the substrate index profile, likely yielding lower average reflectance compared to High-Low ordering which may suffer from strong front-surface reflection."
      ],
      "known_risks": [
        "The optimal thicknesses for this specific ordering might fall outside the 40-160 nm constraint window, forcing a sub-optimal solution at the boundaries.",
        "The constant-index assumption may not perfectly match real dispersion, though the problem mandates constant indices."
      ],
      "execution_request_english": "Execute a deterministic TMM optimization for a planar stack: Incident Medium Air (n=1.0), Layer 1 SiO2 (Gao) (lossless, n=1.46), Layer 2 TiO2 (Siefke) (lossless, n=2.40), Substrate Glass (lossless, n=1.52). Optimize the thickness of Layer 1 and Layer 2 simultaneously. Constraints: Thickness of each layer must be between 40 nm and 160 nm. Objective: Minimize the arithmetic mean of power reflectance for s-polarized light at normal incidence (0 degrees) sampled from 450 nm to 700 nm in 5 nm steps. Use seed 17. Allow maximum 64 solver evaluations. Report the best found thickness pair, the resulting reflectance spectrum, and the calculated mean reflectance.",
      "priority": 1,
      "parent_route_id": null,
      "revision_reason": null
    },
