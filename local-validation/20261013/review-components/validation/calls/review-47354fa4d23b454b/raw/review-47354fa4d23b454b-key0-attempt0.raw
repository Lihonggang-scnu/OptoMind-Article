{"choices":[{"finish_reason":"stop","index":0,"message":{"content":"{\n  \"additions\": [\n    {\n      \"unit_key\": \"CH3:1\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0001\",\n          \"contribution\": \"提供Kho16效率定义的批判性分析，区分绝对与相对效率，并指出全孔径平均效率掩盖了高NA区域因旁瓣增强和采样不足导致的实际性能下降。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"CH3:2\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0001\",\n          \"contribution\": \"通过几何光学推导阐明单界面结构无法校正彗差、场曲和像散，量化NA=0.5时视场小于5 µm的物理极限，确立单层器件与多片式物镜不可直接对比的基准。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"CH3:3\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0001\",\n          \"contribution\": \"论证FWHM作为单一判据的不足，倡导引入MTF以量化旁瓣能量泄漏和对比度损失，为评估偏离衍射极限的实际成像质量提供方法论支持。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"CH3:4\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0001\",\n          \"contribution\": \"结合波导型与共振型相位控制机制（如反对称模式激发），从物理层面解释带宽-视场组合中的工程瓶颈，支撑当前技术尚未突破物理铁律的综合判断。\"\n        }\n      ]\n    }\n  ]\n}","role":"assistant"}}],"created":1791888717,"id":"chatcmpl-f4d27e05-f0ce-9278-b676-d7f683075d54","model":"qwen3.7-flash","object":"chat.completion","usage":{"completion_tokens":402,"prompt_tokens":16322,"prompt_tokens_details":{"cached_tokens":0,"text_tokens":16322},"total_tokens":16724}}