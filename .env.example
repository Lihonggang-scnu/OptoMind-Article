# Copy this file to .env for Docker Compose. Never commit a populated .env.
# Provider secrets stay on the server and are never entered into the browser.
QWEN_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Use a long random value. This protects POST /api/live/runs and /stop.
OPTOMIND_UI_ACCESS_TOKEN=

# Optional host-port mapping for Compose; the container itself listens on 8080.
PORT=8765
